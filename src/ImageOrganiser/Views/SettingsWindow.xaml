<Window x:Class="ImageOrganiser.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        Height="620" Width="560"
        MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/app.ico">

    <DockPanel Margin="12" Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="88" Height="28" Margin="0,0,8,0"
                    IsDefault="True" Click="Ok_Click"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" Width="88" Height="28"
                    IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  DisplayMemberPath="Label"
                                  Width="280" HorizontalAlignment="Left"/>
                        <TextBlock Text="Default is System (follows Windows light/dark). Other options are era styles from Chronolog (Windows 95 through Windows 11 Dark)."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="When deleting copies" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <CheckBox Content="Send deleted copies to the Recycle Bin" IsChecked="{Binding SendToRecycleBin}"/>
                        <CheckBox Content="Ask for confirmation before deleting" IsChecked="{Binding ConfirmDeletes}"/>

                        <TextBlock Text="Desktop shortcuts" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <TextBlock Text="{Binding ShortcutStatus}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Create desktop shortcut" Padding="10,4" Margin="0,0,8,0"
                                    Command="{Binding CreateDesktopShortcutCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button Content="Remove desktop shortcut" Padding="10,4"
                                    Command="{Binding RemoveDesktopShortcutCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"/>
                        </StackPanel>

                        <TextBlock Text="Feedback" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <TextBlock Text="Report issues or request features on GitHub:"
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <Button Content="Open GitHub feedback…" Margin="0,8,0,0" HorizontalAlignment="Left"
                                Padding="10,4" Command="{Binding OpenFeedbackCommand}"
                                Style="{StaticResource ToolbarButtonStyle}"/>

                        <TextBlock Text="Configuration file" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <Border Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushSubtle}"
                                BorderThickness="1" CornerRadius="3" Padding="8,6"
                                SnapsToDevicePixels="True">
                            <TextBox Text="{Binding ConfigPath, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource PrimaryTextBrush}"
                                     SelectionBrush="{DynamicResource ListSelectionBrush}"
                                     Padding="0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Scanning">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Where to look" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Use Locations on the main window (or Tools → Scan locations) to pick entire PC, individual drives and disks, or specific folders. Those choices are saved and used by Scan."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <CheckBox Content="Include removable drives (USB, SD cards) on an entire-PC scan" IsChecked="{Binding IncludeRemovable}"/>
                        <CheckBox Content="Include network drives on an entire-PC scan" IsChecked="{Binding IncludeNetwork}"/>

                        <TextBlock Text="Folders to skip" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <CheckBox Content="Skip Windows / Program Files / other system folders" IsChecked="{Binding SkipSystemFolders}"/>
                        <CheckBox Content="Skip AppData caches" IsChecked="{Binding SkipAppData}"/>
                        <CheckBox Content="Skip hidden and system folders" IsChecked="{Binding SkipHiddenFolders}"/>
                        <TextBlock Text="Extra folders to skip (one full path per line)" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBox Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ExtraExcludeFoldersText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Photo types" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <CheckBox Content="JPEG (.jpg, .jpeg, .jfif)" IsChecked="{Binding IncludeJpeg}"/>
                        <CheckBox Content="PNG" IsChecked="{Binding IncludePng}"/>
                        <CheckBox Content="GIF" IsChecked="{Binding IncludeGif}"/>
                        <CheckBox Content="BMP" IsChecked="{Binding IncludeBmp}"/>
                        <CheckBox Content="TIFF" IsChecked="{Binding IncludeTiff}"/>
                        <CheckBox Content="WebP" IsChecked="{Binding IncludeWebp}"/>

                        <TextBlock Text="Matching" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,8"/>
                        <TextBlock Text="How tight the visual fingerprint must be. Strict = almost identical. Normal = same photo after resize or recompress. Loose = also close crops and light edits."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding SimilarityOptions}"
                                  SelectedItem="{Binding Similarity}"
                                  Width="160" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Minimum file size (KB):" VerticalAlignment="Center" Width="170"/>
                            <TextBox Width="60" Text="{Binding MinFileSizeKb}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Maximum file size (MB):" VerticalAlignment="Center" Width="170"/>
                            <TextBox Width="60" Text="{Binding MaxFileSizeMb}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
